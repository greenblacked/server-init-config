# Authelia configuration, rendered by install.sh (@@KEY@@ placeholders). Secrets come from *_FILE env
# variables set in docker-compose.yml, never from this file.
# Reference: https://www.authelia.com/configuration/ (4.39)
theme: auto
server:
  address: 'tcp://:9091/'
  endpoints:
    authz:
      forward-auth:
        implementation: 'ForwardAuth'
        authn_strategies:
          - name: 'CookieSession'
    # Throttles the second-factor and password-reset endpoints per client address (first-factor attempts are
    # limited by `regulation` below).
    rate_limits:
      reset_password_start:
        enable: true
        buckets:
          - period: '10 minutes'
            requests: 5
      reset_password_finish:
        enable: true
        buckets:
          - period: '10 minutes'
            requests: 5
      second_factor_totp:
        enable: true
        buckets:
          - period: '1 minute'
            requests: 6
          - period: '1 hour'
            requests: 40
log:
  level: 'info'
  format: 'text'
ntp:
  # the container is on an internal network (no internet); the host keeps time (chrony)
  disable_startup_check: true
telemetry:
  metrics:
    enabled: false
identity_validation:
  reset_password:
    # secret is read from AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE
    jwt_lifespan: '5 minutes'
authentication_backend:
  password_reset:
    disable: true
  file:
    path: '/config/users.yml'
    watch: true
    password:
      algorithm: 'argon2'
      argon2:
        variant: 'argon2id'
        iterations: 3
        memory: 32768
        parallelism: 4
        key_length: 32
        salt_length: 16
totp:
  issuer: '@@DOMAIN@@'
access_control:
  default_policy: 'deny'
  rules:
    # the Lampa host (browser sessions get their own Lampac key added by Caddy), TorrServer and qBittorrent
    - domain:
        - '@@DOMAIN@@'
        - 'ts.@@DOMAIN@@'
        - 'qbt.@@DOMAIN@@'
      policy: '@@POLICY@@'
session:
  # secret is read from AUTHELIA_SESSION_SECRET_FILE
  cookies:
    - name: 'lampa_session'
      domain: '@@DOMAIN@@'
      authelia_url: '@@AUTH_URL@@'
      default_redirection_url: '@@MAIN_URL@@'
      expiration: '12 hours'
      inactivity: '1 hour'
      remember_me: '30 days'
regulation:
  # Built-in brute-force protection (the fail2ban of this stack): 3 failed logins within 5 minutes ban that user
  # name AND the client address for 30 minutes; the ban time is the same for the one-time-password step.
  modes:
    - 'user'
    - 'ip'
  max_retries: 3
  find_time: '5 minutes'
  ban_time: '30 minutes'
storage:
  # encryption_key is read from AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE
  local:
    path: '/data/db.sqlite3'
notifier:
  # No mail server: one-time links (TOTP registration) are appended to this file, read on the host.
  filesystem:
    filename: '/data/notification.txt'
