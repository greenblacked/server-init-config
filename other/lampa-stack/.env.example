# Lampa stack settings. install.sh copies this to .env on first run and keeps your edits
# on later runs (it only fills in keys that are missing). Secrets are NOT stored here:
# they live in secrets/ (root-owned, 0600). Change a value, then run: install.sh (it re-applies).

# ---- Pinned images (tag + digest). Bump here to update; see README "Update". No :latest. ----
# Digests are the multi-arch index digests, read from the registries' Docker-Content-Digest header.
# lscr.io/linuxserver/* is a redirect to ghcr.io/linuxserver/*; the digest is the same image.
CADDY_IMAGE=docker.io/library/caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
AUTHELIA_IMAGE=docker.io/authelia/authelia:4.39.28@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
LAMPAC_IMAGE=ghcr.io/lampac-nextgen/lampac:1.28.4@sha256:8e22df8a8592d957af297ba31ad6adb9937bbc962d09ac9a92f68322480f1055
TORRSERVER_IMAGE=ghcr.io/yourok/torrserver:MatriX.147.2@sha256:056e0cf1003c4e6c2c2343797f84734fe4dc48f57d1ed18af6d5ef982fce0f40
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:5.3.0@sha256:75ecbb1c89ab7b0a21c4bde40b4820e4f1649d2d56d83b91913422155e8d2a5f

# ---- Access mode (install.sh sets these; see README "Access modes") ----
# public (default) | local | vpn. Chosen with install.sh --public / --local / --vpn and remembered here.
ACCESS_MODE=public
# public: a Let's Encrypt certificate for <public-ip-dashed>.sslip.io (sslip.io resolves every subdomain to the
# IP in its name: auth.<ip>.sslip.io, ts.<ip>.sslip.io, qbt.<ip>.sslip.io). To use your own domain run
# `DOMAIN=example.org ./install.sh`; example.org, auth., ts. and qbt. must then point at this server.
DOMAIN_CUSTOM=
# Detected on every run (Hetzner metadata, then the route, then api.ipify.org); PUBLIC_IP=a.b.c.d in the environment overrides.
PUBLIC_IP=
# Random TCP port of the one HTTPS listener (public and vpn mode), chosen once in 20000-60000, never the SSH port.
HTTPS_PORT=
# local mode: the loopback port you tunnel to
LOCAL_PORT=8443
# vpn mode: the WireGuard network (the server is .1) and its random UDP port (chosen once)
WG_NET=10.88.77
WG_PORT=
# Written by install.sh from the above; the compose file reads them. Do not edit.
BASE_HOST=lampa.localhost
SITE_PORT=8443
# Optional: Let's Encrypt expiry notices
ACME_EMAIL=

# ---- Users and login policy ----
STACK_UID=10000
# one_factor = password; two_factor = password + TOTP (register a device on first login).
AUTHELIA_POLICY=one_factor
# Lampa is NOT inside the Lampac image: the LampaWeb module downloads it from GitHub on the first start
# (needs outbound access to github.com), then keeps it in data/lampac/lampa-main. With a pinned LAMPA_TREE
# that is one fixed commit, downloaded once; "false" means no frontend unless you put Lampa there yourself.
LAMPA_AUTOUPDATE=true
LAMPA_TREE=b6a0b42d23fb9de42f9cd163bb698cb03333997d

# ---- Lampac modules ----
# Online sources (/online.js). On by default.
LAMPAC_ONLINE=1
# SISI = 18+ section (/sisi.js). ADULTS ONLY, off by default: install.sh --enable-sisi / --disable-sisi.
LAMPAC_SISI=0
# Lampac's own /proxy links are encrypted by Lampac and carry no key (players cannot add one). 1 lets them through
# Caddy without a key so playback works; 0 requires a key everywhere, which breaks external players. See README.
LAMPAC_PROXY_ANON=0

# ---- TorrServer (streaming only: RAM cache, no seeding, no disk) ----
# RAM cache in MB; must fit TORRSERVER_MEM with 160 MB to spare (checked by install.sh).
TS_CACHE_MB=384
# % of the cache TorrServer fills before playback starts (0-100) and how far ahead it reads (5-100)
TS_PRELOAD_PCT=20
TS_READAHEAD_PCT=90
# seconds without a reader before a torrent is dropped (and its cache with it)
TS_IDLE_SECONDS=120
# Go heap limit, computed by install.sh from TORRSERVER_MEM
TS_GOMEMLIMIT_MB=720
# ---- qBittorrent (seeding allowed) ----
QBT_USER=admin
QBT_WEBUI_PORT=8085
# Peer port. Published on 127.0.0.1 only (i.e. not reachable) unless install.sh --enable-qbt-port, which also
# replaces this default with a random port in 20000-60000 (kept in this file).
QBT_PORT=6881
QBT_PEER_BIND=127.0.0.1
# Stop (pause, never delete) seeding at this ratio OR after this many minutes (10080 = 7 days).
QBT_MAX_RATIO=2.0
QBT_MAX_SEED_MINUTES=10080
# Optional: remove finished torrents' files after this many days (0 = never). Applied by the cleanup
# timer only when set. Default off: this client is meant to seed.
QBT_DELETE_COMPLETED_DAYS=0

# ---- Resource limits (sum fits a 4 GB host, see README "Memory budget") ----
LAMPAC_MEM=1024m
LAMPAC_SHM=256m
TORRSERVER_MEM=768m
QBT_MEM=512m
AUTHELIA_MEM=256m
CADDY_MEM=96m
# Lampac's root filesystem must stay writable (LampaWeb unpacks Lampa into /lampac/wwwroot); true is unsupported.
LAMPAC_READ_ONLY=false
