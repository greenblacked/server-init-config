# TLS front for TorrServer, used only with install.sh --public. DOMAIN and ACME_EMAIL come from .env.
{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
	}
}

(torrserver_proxy) {
	reverse_proxy torrserver:8090 {
		flush_interval -1
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}

	# TorrServer leaves /play, /subs, /playlist, /stream and /swagger outside its own login, so Caddy
	# asks for the same login (bcrypt hash in auth.caddy, written by install.sh) on every path but /echo.
	# The Authorization header is passed on, so TorrServer's own check passes as well.
	@echo path /echo
	handle @echo {
		import torrserver_proxy
	}
	handle {
		import /etc/caddy/auth.caddy
		import torrserver_proxy
	}

	log {
		output stdout
		format console
	}
}
