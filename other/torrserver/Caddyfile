# TLS front for TorrServer in public mode (install.sh default). Values come from .env:
#   TS_HOSTNAME     <ip-with-dashes>.sslip.io, or your DOMAIN
#   TS_PUBLIC_PORT  the random high port clients use, for example 43817
# tls.caddy (written by install.sh) holds the certificate issuer; caddy-auth.caddy the bcrypt login.
{
	admin off
	servers {
		protocols h1 h2
	}
}

(torrserver_proxy) {
	reverse_proxy torrserver:8090 {
		flush_interval -1
	}
}

# HTTPS on the random port. Plain HTTP on port 80 is only the automatic redirect and the ACME challenge:
# the login is never accepted or served there.
{$TS_HOSTNAME}:{$TS_PUBLIC_PORT} {
	import /etc/caddy/tls.caddy

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# TorrServer leaves /play, /subs, /playlist, /stream and /swagger outside its own login, so Caddy
	# asks for the same login (bcrypt hash in auth.caddy, written by install.sh) on every path but /echo.
	# The Authorization header is passed on, so TorrServer's own check passes as well.
	@echo path /echo
	handle @echo {
		import torrserver_proxy
	}
	handle {
		import /etc/caddy/auth.caddy
		import torrserver_proxy
	}

	# JSON access log for fail2ban (jail torrserver-caddy bans repeated 401s). Authorization and Cookie
	# headers are redacted by Caddy. Rotated by Caddy itself.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
