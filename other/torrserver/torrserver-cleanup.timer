[Unit]
Description=Clean TorrServer downloads every 3 days

[Timer]
# Monotonic on purpose: OnCalendar day-of-month steps like *-*-01/3 restart at every month end
# (31st -> 1st is a 1-day gap), and a weekly/daily pattern is not "every 3 days".
# OnUnitActiveSec=3d is exactly 3 days after the last run; OnBootSec covers a server that was
# off or rebooted (the timer restarts after boot and the first run follows 1 h later).
OnBootSec=1h
OnUnitActiveSec=3d
RandomizedDelaySec=15min
AccuracySec=1min

[Install]
WantedBy=timers.target
