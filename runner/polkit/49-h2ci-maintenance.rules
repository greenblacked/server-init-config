polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "ops" && action.lookup("verb") === "start" &&
        (action.lookup("unit") === "h2ci-server-update.service" ||
         action.lookup("unit") === "server-freshness.service")) {
        return polkit.Result.YES;
    }
});
