# Admin tools (htop, btop, ncdu, mtr, vim, rsync, skopeo, mc, fd-find, ripgrep, fzf, ...) come from EPEL and are installed one by one in
# runcmd, so a missing one cannot break the package step; it is logged to /var/log/ci-bootstrap-failed.log.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - gnupg2
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
@@INCLUDE runner/cloud-init/templates/common-files.yaml.in@@

  # Vendor repos, disabled until runcmd has pinned their keys (a repo with a missing gpgkey file breaks every dnf call).
  - path: /etc/yum.repos.d/docker-ce.repo
    permissions: '0644'
    content: |
      [docker-ce-stable]
      name=Docker CE Stable
      baseurl=https://download.docker.com/linux/rhel/$releasever/$basearch/stable
      enabled=0
      gpgcheck=1
      gpgkey=file:///etc/pki/rpm-gpg/docker-ce.asc

  - path: /etc/yum.repos.d/gitlab-runner.repo
    permissions: '0644'
    content: |
      [runner_gitlab-runner]
      name=GitLab Runner
      baseurl=https://packages.gitlab.com/runner/gitlab-runner/el/$releasever/$basearch
      enabled=0
      gpgcheck=1
      repo_gpgcheck=1
      gpgkey=file:///etc/pki/rpm-gpg/gitlab-runner.asc file:///etc/pki/rpm-gpg/gitlab-runner-pkg.asc
      metadata_expire=300

  - path: /etc/systemd/system/registry-cache.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Docker Hub pull-through cache
      After=docker.service
      Requires=docker.service
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/bin/docker compose -f /opt/registry-cache/docker-compose.yml up -d
      [Install]
      WantedBy=multi-user.target

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /usr/local/bin /usr/local/sbin /etc/systemd/system /etc/yum.repos.d /etc/sysctl.d
  - [sh, -c, "if sshd -t; then systemctl reload sshd; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo dnf-utils mc fd-find ripgrep fzf; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf
  - [systemctl, enable, --now, dnf-automatic.timer]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - [sysctl, --system]
  - pin-repo-key https://download.docker.com/linux/rhel/gpg 060A61C51B558A7F742B77AAC52FEB6B621E9F35 /etc/pki/rpm-gpg/docker-ce.asc && sed -i 's/^enabled=0/enabled=1/' /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - semanage fcontext -a -t container_file_t '/opt/registry-cache(/.*)?'
  - restorecon -R /opt/registry-cache
  # Fingerprints from https://docs.gitlab.com/runner/install/linux-repository/: F640... signs the repo metadata, 931D... the RPMs.
  - pin-repo-key https://packages.gitlab.com/runner/gitlab-runner/gpgkey F6403F6544A38863DAA0B6E03F01618A51312F3F /etc/pki/rpm-gpg/gitlab-runner.asc && pin-repo-key https://packages.gitlab.com/gpgkey/runner/49F16C5CC3A0F81F.pub.gpg 931DA69CFA3AFEBBC97DAA8C6C57C29C6BA75A4E /etc/pki/rpm-gpg/gitlab-runner-pkg.asc && sed -i 's/^enabled=0/enabled=1/' /etc/yum.repos.d/gitlab-runner.repo
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, runner-weekly-cleanup.timer, runner-disk-guard.timer, runner-engine-update.timer, ci-job-isolation.service, registry-cache.service]
  - sed -i -E 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
  - setenforce 1
  # The old image kernel has no kernel-modules (netfilter) after the upgrade, so dockerd fails until the new kernel boots: reboot once.
  - [sh, -c, "systemctl is-active -q docker || [ \"$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\\n' | sort -V | tail -1)\" = \"$(uname -r)\" ] || { journalctl -u docker -n 20 --no-pager > /var/log/ci-docker-reboot.log; systemctl reboot --no-block; }"]
