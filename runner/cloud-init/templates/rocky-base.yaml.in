# Admin tools (htop, btop, ncdu, iotop, mtr, nano, vim, rsync, wget, unzip, bash-completion, skopeo, restic, dnf-utils, mc, fd-find, ripgrep, fzf)
# are installed in runcmd after EPEL is enabled, one by one: htop and several others come from EPEL,
# so listing it under packages: would break the whole package step. Missing ones go to /var/log/ci-bootstrap-failed.log.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
@@INCLUDE runner/cloud-init/templates/common-files.yaml.in@@

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /usr/local/bin /etc/systemd/system
  - [sh, -c, "if sshd -t; then systemctl reload sshd; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo restic dnf-utils mc fd-find ripgrep fzf; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf
  - [systemctl, enable, --now, dnf-automatic.timer]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - sh -c 'systemctl is-enabled firewalld >/dev/null 2>&1 && systemctl disable --now firewalld || true'
  - curl -fsSL https://download.docker.com/linux/rhel/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - semanage fcontext -a -t container_file_t '/opt/registry-cache(/.*)?'
  - restorecon -R /opt/registry-cache
  - docker compose -f /opt/registry-cache/docker-compose.yml up -d
  - curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.rpm.sh -o /tmp/runner-repo.sh
  - bash /tmp/runner-repo.sh
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, runner-weekly-cleanup.timer, runner-disk-guard.timer]
  - sed -i -E 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
  - setenforce 1
