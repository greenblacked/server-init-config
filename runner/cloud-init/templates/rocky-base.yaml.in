# Admin tools (htop, btop, ncdu, iotop, mtr, nano, vim, rsync, wget, unzip, bash-completion, skopeo, restic, dnf-utils, mc, fd-find, ripgrep, fzf)
# are installed in runcmd after EPEL is enabled, one by one: htop and several others come from EPEL,
# so listing it under packages: would break the whole package step. Missing ones go to /var/log/ci-bootstrap-failed.log.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - gnupg2
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
@@INCLUDE runner/cloud-init/templates/common-files.yaml.in@@

  # Vendor repositories, written here instead of piping the vendors' install scripts into a root shell.
  # The signing keys are fetched in runcmd and installed only if their fingerprints match (pin-repo-key).
  - path: /etc/yum.repos.d/docker-ce.repo
    permissions: '0644'
    content: |
      [docker-ce-stable]
      name=Docker CE Stable
      baseurl=https://download.docker.com/linux/rhel/$releasever/$basearch/stable
      enabled=1
      gpgcheck=1
      gpgkey=file:///etc/pki/rpm-gpg/docker-ce.asc

  - path: /etc/yum.repos.d/gitlab-runner.repo
    permissions: '0644'
    content: |
      [runner_gitlab-runner]
      name=GitLab Runner
      baseurl=https://packages.gitlab.com/runner/gitlab-runner/el/$releasever/$basearch
      enabled=1
      gpgcheck=1
      repo_gpgcheck=0
      gpgkey=file:///etc/pki/rpm-gpg/gitlab-runner.asc
      metadata_expire=300

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /usr/local/bin /usr/local/sbin /etc/systemd/system /etc/yum.repos.d /etc/sysctl.d
  - [sh, -c, "if sshd -t; then systemctl reload sshd; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo restic dnf-utils mc fd-find ripgrep fzf; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf
  - [systemctl, enable, --now, dnf-automatic.timer]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - [sysctl, --system]
  - [pin-repo-key, "https://download.docker.com/linux/rhel/gpg", "9DC858229FC7DD38854AE2D88D81803C0EBFCD88", /etc/pki/rpm-gpg/docker-ce.asc]
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - semanage fcontext -a -t container_file_t '/opt/registry-cache(/.*)?'
  - restorecon -R /opt/registry-cache
  - docker compose -f /opt/registry-cache/docker-compose.yml up -d
  # UNVERIFIED offline: this fingerprint is from GitLab's Runner install docs; check it against https://docs.gitlab.com/runner/install/linux-repository/
  - [pin-repo-key, "https://packages.gitlab.com/runner/gitlab-runner/gpgkey", "F6403F6544A38863DAA0B6E03F01618A51312F3F", /etc/pki/rpm-gpg/gitlab-runner.asc]
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, runner-weekly-cleanup.timer, runner-disk-guard.timer, runner-engine-update.timer, ci-job-isolation.service]
  - sed -i -E 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
  - setenforce 1
