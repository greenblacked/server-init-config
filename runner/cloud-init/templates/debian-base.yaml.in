package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - gnupg
  - git
  - jq
  - htop
  - tmux
  - unattended-upgrades

ssh_pwauth: false

write_files:
@@INCLUDE runner/cloud-init/templates/common-files.yaml.in@@

  - path: /etc/apt/preferences.d/pin-gitlab-runner.pref
    permissions: '0644'
    content: |
      Explanation: Prefer GitLab provided packages over the Debian native ones
      Package: gitlab-runner
      Pin: origin packages.gitlab.com
      Pin-Priority: 1001

runcmd:
  - [sh, -c, "if sshd -t; then systemctl reload ssh; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [systemctl, enable, --now, unattended-upgrades]
  - [sh, -c, "for p in mc fd-find ripgrep fzf; do apt-get install -y -q $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done; if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then ln -sfn $(command -v fdfind) /usr/local/bin/fd; fi"]
  - [sh, -c, "for rc in /etc/skel/.bashrc /root/.bashrc /home/*/.bashrc; do [ -f $rc ] && sed -i -E 's/^(HISTSIZE=1000|HISTFILESIZE=2000)$/# &/' $rc; done; true"]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - install -m 0755 -d /etc/apt/keyrings
  - [sysctl, --system]
  # Vendor keys are installed only if their fingerprints match (pin-repo-key); no vendor script is piped into a shell.
  - [pin-repo-key, "https://download.docker.com/linux/debian/gpg", "9DC858229FC7DD38854AE2D88D81803C0EBFCD88", /etc/apt/keyrings/docker.asc]
  - sh -c '. /etc/os-release; echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update -q
  - apt-get install -y -q docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - docker compose -f /opt/registry-cache/docker-compose.yml up -d
  # UNVERIFIED offline: this fingerprint is from GitLab's Runner install docs; check it against https://docs.gitlab.com/runner/install/linux-repository/
  - [pin-repo-key, "https://packages.gitlab.com/runner/gitlab-runner/gpgkey", "F6403F6544A38863DAA0B6E03F01618A51312F3F", /etc/apt/keyrings/gitlab-runner.asc]
  - sh -c '. /etc/os-release; echo "deb [signed-by=/etc/apt/keyrings/gitlab-runner.asc] https://packages.gitlab.com/runner/gitlab-runner/debian ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/gitlab-runner.list'
  - apt-get update -q
  - apt-get install -y -q gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, runner-weekly-cleanup.timer, runner-disk-guard.timer, runner-engine-update.timer, ci-job-isolation.service]
