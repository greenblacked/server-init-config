#cloud-config
# Clean GitLab Runner host for Rocky Linux 9/10 (ARM64 and x86_64): Docker Engine + GitLab Runner (docker executor).
# Generated by tools/render-cloud-init.py from runner/cloud-init/templates. Do not edit by hand.
# Paste into Hetzner "Cloud config" when creating the server.
# Login stays as Hetzner sets it up: root with your SSH key on port 22. Only password logins are switched off.
# Nothing here changes users, the SSH port, SELinux mode, the firewall or the user the services run as; install those
# (and everything else) later with runner/setup.sh or COMMANDS.md.
# Admin tools from EPEL (htop, mc, fzf, ripgrep, fd-find and others) are installed one by one in runcmd: a missing one is logged to
# /var/log/ci-bootstrap-failed.log and does not stop the boot.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - gnupg2
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/00-ci-hardening.conf
    permissions: '0600'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no

  - path: /etc/gai.conf
    append: true
    content: |
      precedence ::ffff:0:0/96  100

  - path: /etc/systemd/journald.conf.d/50-size.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=500M
      MaxRetentionSec=14day

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /etc/gitlab-runner/config.toml
    permissions: '0600'
    content: |
      concurrent = 2
      check_interval = 0
      listen_address = "127.0.0.1:9252"

  - path: /root/.tmux.conf
    permissions: '0644'
    content: |
      set -g mouse on
      set -g history-limit 50000
      set -g base-index 1
      set -g status-right '#H  %H:%M'

  - path: /etc/profile.d/ci-runner.sh
    permissions: '0644'
    content: |
      alias health='sudo /usr/local/bin/health'
      alias runner-logs='sudo journalctl -u gitlab-runner -f'
      alias runner-errors='sudo journalctl -u gitlab-runner --since "-30min" --no-pager | grep -Ei "error|warn|bottleneck"'
      alias runner-jobs='sudo docker ps --filter label=com.gitlab.gitlab-runner.managed=true --format "{{.Names}}  {{.Status}}"'
      alias runner-metrics='curl -s 127.0.0.1:9252/metrics | grep "^gitlab_runner_"'
      alias dfd='df -h / ; sudo docker system df'
      alias dstats='sudo docker stats --no-stream'

  # Vendor repositories written here instead of piping the vendors' install scripts into a root shell. Disabled (enabled=0)
  # until runcmd has pinned their keys (pin-repo-key) and turns them on: with the key file missing every dnf call fails.
  - path: /etc/yum.repos.d/docker-ce.repo
    permissions: '0644'
    content: |
      [docker-ce-stable]
      name=Docker CE Stable
      baseurl=https://download.docker.com/linux/rhel/$releasever/$basearch/stable
      enabled=0
      gpgcheck=1
      gpgkey=file:///etc/pki/rpm-gpg/docker-ce.asc

  - path: /etc/yum.repos.d/gitlab-runner.repo
    permissions: '0644'
    content: |
      [runner_gitlab-runner]
      name=GitLab Runner
      baseurl=https://packages.gitlab.com/runner/gitlab-runner/el/$releasever/$basearch
      enabled=0
      gpgcheck=1
      repo_gpgcheck=1
      gpgkey=file:///etc/pki/rpm-gpg/gitlab-runner.asc file:///etc/pki/rpm-gpg/gitlab-runner-pkg.asc
      metadata_expire=300

  - path: /usr/local/sbin/pin-repo-key
    permissions: '0755'
    content: |
@@FILE common/pin-repo-key.sh@@

  - path: /etc/sysctl.d/90-ci-hardening.conf
    permissions: '0644'
    content: |
@@FILE common/sysctl-hardening.conf@@

  - path: /etc/security/limits.d/50-nocore.conf
    permissions: '0644'
    content: |
      * hard core 0

  - path: /etc/systemd/coredump.conf.d/50-off.conf
    permissions: '0644'
    content: |
      [Coredump]
      Storage=none
      ProcessSizeMax=0

  - path: /etc/profile.d/90-shell-history.sh
    permissions: '0644'
    content: |
@@FILE common/shell-history.sh@@

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /etc/profile.d /usr/local/sbin /etc/yum.repos.d /etc/sysctl.d
  - [sysctl, --system]
  - [sh, -c, "if sshd -t; then systemctl reload sshd; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo dnf-utils mc fd-find ripgrep fzf; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - [sh, -c, "if [ -f /etc/dnf/automatic.conf ]; then sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf && systemctl enable --now dnf-automatic.timer; else echo dnf-automatic-config-not-found >> /var/log/ci-bootstrap-failed.log; fi"]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - pin-repo-key https://download.docker.com/linux/rhel/gpg 060A61C51B558A7F742B77AAC52FEB6B621E9F35 /etc/pki/rpm-gpg/docker-ce.asc && sed -i 's/^enabled=0/enabled=1/' /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  # UNVERIFIED offline (packages.gitlab.com was unreachable): both fingerprints come from GitLab's Runner install docs
  # (https://docs.gitlab.com/runner/install/linux-repository/). F640... signs the repository metadata (repo_gpgcheck),
  # 931D... signs the RPM packages (gpgcheck). Check them and the package key's expiry before relying on this on a new image.
  - pin-repo-key https://packages.gitlab.com/runner/gitlab-runner/gpgkey F6403F6544A38863DAA0B6E03F01618A51312F3F /etc/pki/rpm-gpg/gitlab-runner.asc && pin-repo-key https://packages.gitlab.com/gpgkey/runner/49F16C5CC3A0F81F.pub.gpg 931DA69CFA3AFEBBC97DAA8C6C57C29C6BA75A4E /etc/pki/rpm-gpg/gitlab-runner-pkg.asc && sed -i 's/^enabled=0/enabled=1/' /etc/yum.repos.d/gitlab-runner.repo
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, restart, gitlab-runner]
  # The old image kernel has no kernel-modules (netfilter) after the upgrade, so dockerd fails until the new kernel boots: reboot once, after cloud-init is done.
  - [sh, -c, "systemctl is-active -q docker || [ \"$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\\n' | sort -V | tail -1)\" = \"$(uname -r)\" ] || { journalctl -u docker -n 20 --no-pager > /var/log/ci-docker-reboot.log; systemd-run --no-block -p After=cloud-final.service systemctl reboot; }"]
  - [sh, -c, "for s in sshd docker gitlab-runner; do systemctl is-active --quiet $s || [ $s = docker -a -s /var/log/ci-docker-reboot.log ] || echo bootstrap-check-failed-$s >> /var/log/ci-bootstrap-failed.log; done"]
