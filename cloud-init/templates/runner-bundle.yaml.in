#cloud-config
# GitLab Runner host for Rocky Linux 9/10 (ARM64 and x86_64), everything in one paste.
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
# Installs Docker and GitLab Runner, unpacks the base set of this repo to /opt/server-init-config and runs
# setup.sh --base (health, cleanup timers, Docker Hub cache, Prometheus + Grafana). Afterwards only the runner
# token is left:  /opt/server-init-config/gitlab-runner/setup.sh --register
# The rest (update.sh, npm cache, prewarm, Grafana domain) comes with a full copy of the repo.
package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/00-ci-hardening.conf
    permissions: '0600'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no

  - path: /etc/gai.conf
    append: true
    content: |
      precedence ::ffff:0:0/96  100

  - path: /etc/systemd/journald.conf.d/50-size.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=500M
      MaxRetentionSec=14day

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /etc/gitlab-runner/config.toml
    permissions: '0600'
    content: |
      concurrent = 2
      check_interval = 0
      listen_address = "127.0.0.1:9252"

  - path: /opt/server-init-config.tar
    permissions: '0600'
    encoding: gz+b64
@@BUNDLE bundle@@

  - path: /root/.tmux.conf
    permissions: '0644'
    content: |
      set -g mouse on
      set -g history-limit 50000
      set -g base-index 1
      set -g status-right '#H  %H:%M'

  - path: /etc/profile.d/ci-runner.sh
    permissions: '0644'
    content: |
      alias runner-logs='journalctl -u gitlab-runner -f'
      alias runner-errors='journalctl -u gitlab-runner --since "-30min" --no-pager | grep -Ei "error|warn|bottleneck"'
      alias runner-jobs='docker ps --filter label=com.gitlab.gitlab-runner.managed=true --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
      alias runner-metrics='curl -s 127.0.0.1:9252/metrics | grep "^gitlab_runner_"'
      alias dfd='df -h / ; docker system df'
      alias dstats='docker stats --no-stream'

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /etc/profile.d
  - [sh, -c, "sshd -t && systemctl reload sshd"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop ncdu iotop; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - [sh, -c, "if [ -f /etc/dnf/automatic.conf ]; then sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf && systemctl enable --now dnf-automatic.timer; else echo 'dnf-automatic config not found, set it up manually' >&2; fi"]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - curl -fsSL https://download.docker.com/linux/rhel/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.rpm.sh -o /tmp/runner-repo.sh
  - bash /tmp/runner-repo.sh
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, restart, gitlab-runner]
  - [sh, -c, "install -d -m 0755 /opt/server-init-config && tar -xf /opt/server-init-config.tar -C /opt/server-init-config && rm -f /opt/server-init-config.tar"]
  - [sh, -c, "bash /opt/server-init-config/gitlab-runner/setup.sh --base >> /var/log/server-init-setup.log 2>&1 || echo setup-base-failed-see-/var/log/server-init-setup.log >> /var/log/ci-bootstrap-failed.log"]
  - [sh, -c, "for s in docker gitlab-runner; do systemctl is-active --quiet $s || echo bootstrap-check-failed-$s >> /var/log/ci-bootstrap-failed.log; done"]
