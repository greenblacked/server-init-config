#cloud-config
# Debian 13 (ARM64 and x86_64): Docker, GitLab Runner, Docker Hub cache, cleanup timers.
# Log in as ops on port 22022 (sudo without password); allow TCP 22022 in the Hetzner Firewall.
# Root SSH and port 22 are closed at the end of the first boot.
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - gnupg
  - git
  - jq
  - htop
  - tmux
  - unattended-upgrades

ssh_pwauth: false

write_files:
@@INCLUDE cloud-init/templates/common-files.yaml.in@@

  - path: /etc/apt/preferences.d/pin-gitlab-runner.pref
    permissions: '0644'
    content: |
      Explanation: Prefer GitLab provided packages over the Debian native ones
      Package: gitlab-runner
      Pin: origin packages.gitlab.com
      Pin-Priority: 1001

runcmd:
  - [sh, -c, "/usr/local/sbin/server-users || echo users-setup-failed >> /var/log/ci-bootstrap-failed.log"]
  - [systemctl, enable, --now, unattended-upgrades]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - sh -c '. /etc/os-release; echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update -q
  - apt-get install -y -q docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - docker compose -f /opt/registry-cache/docker-compose.yml up -d
  - curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh -o /tmp/runner-repo.sh
  - bash /tmp/runner-repo.sh
  - apt-get install -y -q gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, runner-weekly-cleanup.timer, runner-disk-guard.timer]
  - [sh, -c, "/usr/local/sbin/server-users --lock-root || echo users-lock-root-failed-root-ssh-still-open >> /var/log/ci-bootstrap-failed.log"]
