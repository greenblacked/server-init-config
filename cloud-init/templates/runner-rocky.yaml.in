#cloud-config
# Clean GitLab Runner host for Rocky Linux 9/10 (ARM64 and x86_64): Docker Engine + GitLab Runner (docker executor).
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
# Paste into Hetzner "Cloud config" when creating the server.
# Login stays as Hetzner sets it up: root with your SSH key on port 22. Only password logins are switched off.
# Nothing here changes users, the SSH port, SELinux mode or the user the services run as; install those
# (and everything else) later with gitlab-runner/setup.sh or COMMANDS.md.
# Admin tools from EPEL (htop, mc, fzf, ripgrep, fd-find and others) are installed one by one in runcmd: a missing one is logged to
# /var/log/ci-bootstrap-failed.log and does not stop the boot.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/00-ci-hardening.conf
    permissions: '0600'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no

  - path: /etc/gai.conf
    append: true
    content: |
      precedence ::ffff:0:0/96  100

  - path: /etc/systemd/journald.conf.d/50-size.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=500M
      MaxRetentionSec=14day

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /etc/gitlab-runner/config.toml
    permissions: '0600'
    content: |
      concurrent = 2
      check_interval = 0
      listen_address = "127.0.0.1:9252"

  - path: /root/.tmux.conf
    permissions: '0644'
    content: |
      set -g mouse on
      set -g history-limit 50000
      set -g base-index 1
      set -g status-right '#H  %H:%M'

  - path: /etc/profile.d/ci-runner.sh
    permissions: '0644'
    content: |
      alias runner-logs='journalctl -u gitlab-runner -f'
      alias runner-errors='journalctl -u gitlab-runner --since "-30min" --no-pager | grep -Ei "error|warn|bottleneck"'
      alias runner-jobs='docker ps --filter label=com.gitlab.gitlab-runner.managed=true --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
      alias runner-metrics='curl -s 127.0.0.1:9252/metrics | grep "^gitlab_runner_"'
      alias dfd='df -h / ; docker system df'
      alias dstats='docker stats --no-stream'

  - path: /etc/profile.d/90-shell-history.sh
    permissions: '0644'
    content: |
@@FILE scripts/shell-history.sh@@

runcmd:
  - restorecon -R /etc/ssh/sshd_config.d /etc/docker /etc/gitlab-runner /etc/profile.d
  - [sh, -c, "if sshd -t; then systemctl reload sshd; else rm -f /etc/ssh/sshd_config.d/00-ci-hardening.conf; echo ssh-dropin-rejected-defaults-kept >> /var/log/ci-bootstrap-failed.log; fi"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo restic dnf-utils mc fd-find ripgrep fzf; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - [sh, -c, "if [ -f /etc/dnf/automatic.conf ]; then sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf && systemctl enable --now dnf-automatic.timer; else echo dnf-automatic-config-not-found >> /var/log/ci-bootstrap-failed.log; fi"]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - curl -fsSL https://download.docker.com/linux/rhel/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.rpm.sh -o /tmp/runner-repo.sh
  - bash /tmp/runner-repo.sh
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, restart, gitlab-runner]
  - [sh, -c, "for s in sshd docker gitlab-runner; do systemctl is-active --quiet $s || echo bootstrap-check-failed-$s >> /var/log/ci-bootstrap-failed.log; done"]
