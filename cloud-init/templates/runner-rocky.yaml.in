#cloud-config
# Minimal GitLab Runner host for Rocky Linux 9/10 (ARM64 and x86_64): Docker Engine + GitLab Runner (docker executor).
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
# Log in as rocky (sudo without password). gitlab-runner and monitoring are service accounts without
# login; the runner service runs as gitlab-runner. SSH moves to port 22022: allow TCP 22022 in the Hetzner Firewall.
# Root SSH and port 22 are closed at the end of the first boot.
# Paste into Hetzner "Cloud config" when creating the server, then install components with gitlab-runner/setup.sh or COMMANDS.md.
# Admin tools (htop, btop, ncdu, iotop, mtr, nano, vim, rsync, wget, unzip, bash-completion, skopeo, restic, dnf-utils)
# are installed in runcmd after EPEL is enabled, one by one: htop and several others come from EPEL,
# so listing it under packages: would break the whole package step. Missing ones go to /var/log/ci-bootstrap-failed.log.
package_update: true
package_upgrade: true

packages:
  - sudo
  - curl
  - ca-certificates
  - git
  - jq
  - tmux
  - dnf-automatic
  - policycoreutils-python-utils
  - bind-utils
  - lsof
  - sysstat
  - tcpdump
  - traceroute
  - nmap-ncat

ssh_pwauth: false

write_files:
  - path: /usr/local/sbin/server-users
    permissions: '0755'
    content: |
@@FILE install/users.sh@@

  - path: /etc/gai.conf
    append: true
    content: |
      precedence ::ffff:0:0/96  100

  - path: /etc/systemd/journald.conf.d/50-size.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=500M
      MaxRetentionSec=14day

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /etc/gitlab-runner/config.toml
    permissions: '0600'
    content: |
      concurrent = 2
      check_interval = 0
      listen_address = "127.0.0.1:9252"

  - path: /root/.tmux.conf
    permissions: '0644'
    content: |
      set -g mouse on
      set -g history-limit 50000
      set -g base-index 1
      set -g status-right '#H  %H:%M'

  - path: /etc/profile.d/ci-runner.sh
    permissions: '0644'
    content: |
      alias health='sudo health'
      alias runner-logs='sudo journalctl -u gitlab-runner -f'
      alias runner-errors='sudo journalctl -u gitlab-runner --since "-30min" --no-pager | grep -Ei "error|warn|bottleneck"'
      alias runner-jobs='sudo docker ps --filter label=com.gitlab.gitlab-runner.managed=true --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
      alias runner-metrics='curl -s 127.0.0.1:9252/metrics | grep "^gitlab_runner_"'
      alias dfd='df -h / ; sudo docker system df'
      alias dstats='sudo docker stats --no-stream'

runcmd:
  - restorecon -R /etc/docker /etc/gitlab-runner /etc/profile.d /usr/local/sbin
  - [sh, -c, "/usr/local/sbin/server-users || echo users-setup-failed >> /var/log/ci-bootstrap-failed.log"]
  - [sh, -c, "dnf -y -q install epel-release || echo optional-tool-missing-epel >> /var/log/ci-bootstrap-failed.log; for p in htop btop ncdu iotop mtr nano vim-enhanced rsync wget unzip tar bash-completion skopeo restic dnf-utils; do dnf -y -q install $p || echo optional-tool-missing-$p >> /var/log/ci-bootstrap-failed.log; done"]
  - [sh, -c, "if [ -f /etc/dnf/automatic.conf ]; then sed -i -E 's/^upgrade_type = .*/upgrade_type = security/; s/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf && systemctl enable --now dnf-automatic.timer; else echo 'dnf-automatic config not found, set it up manually' >&2; fi"]
  - [systemctl, restart, systemd-journald]
  - [timedatectl, set-timezone, Europe/Kyiv]
  - curl -fsSL https://download.docker.com/linux/rhel/docker-ce.repo -o /etc/yum.repos.d/docker-ce.repo
  - dnf -y -q install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - [systemctl, enable, --now, docker]
  - curl -fsSL https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.rpm.sh -o /tmp/runner-repo.sh
  - bash /tmp/runner-repo.sh
  - dnf -y -q install gitlab-runner
  - usermod -aG docker gitlab-runner
  - chmod 600 /etc/gitlab-runner/config.toml
  - [systemctl, restart, gitlab-runner]
  - [sh, -c, "/usr/local/sbin/server-users --lock-root || echo users-lock-root-failed-root-ssh-still-open >> /var/log/ci-bootstrap-failed.log"]
  - [sh, -c, "for s in docker gitlab-runner; do systemctl is-active --quiet $s || echo bootstrap-check-failed-$s >> /var/log/ci-bootstrap-failed.log; done"]
