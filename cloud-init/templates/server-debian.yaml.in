#cloud-config
# Ubuntu 26.04 (also 24.04) or Debian 13 (ARM64 and x86_64): general server base setup (not a CI runner).
# Paste this into the Hetzner Console "Cloud config" field when you create the server.
# Do NOT paste it into a terminal; it is user-data for cloud-init, not shell commands.
# Sets up: SSH keys only, admin user ops with sudo, ufw (only SSH open), fail2ban, daily security
# updates (no auto-reboot), Docker Engine + Compose, swap if none, sysctl, journald limit, time sync, admin tools.
# Root keeps key login on port 22, so this cannot lock you out.
# To change settings (ports, admin user, Docker, swap, timezone, app), edit the /etc/server-init.conf block below first.
# Rerun any time as root: /usr/local/sbin/server-init.sh
# A failed step is logged to /var/log/server-init-failed.log and the next step still runs.
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
package_update: true
package_upgrade: true
ssh_pwauth: false

write_files:
  - path: /etc/server-init.conf
    permissions: '0644'
    content: |
      # Read by /usr/local/sbin/server-init.sh. Edit, then rerun the script as root.
      ADMIN_USER=ops
      # Extra open ports, space separated, e.g. "80/tcp 443/tcp". SSH (22/tcp) is always open.
      EXTRA_PORTS=""
      # Set to 0 to skip a component.
      INSTALL_DOCKER=1
      INSTALL_SWAP=1
      TIMEZONE=Europe/Kyiv
      # Hetzner Apps image: auto detects it, none ignores it, or name it: coolify docker-ce gitlab jitsi owncast
      # photoprism prometheus-grafana rustdesk. A detected app gets its own ports opened in ufw.
      APP=auto

  - path: /usr/local/sbin/server-init.sh
    permissions: '0755'
    content: |
@@FILE server/server-init-debian.sh@@

runcmd:
  - [bash, /usr/local/sbin/server-init.sh]
