#cloud-config
# openSUSE Leap 16.0 (ARM64 and x86_64): general server base setup (not a CI runner).
# Paste this into the Hetzner Console "Cloud config" field when you create the server.
# Do NOT paste it into a terminal; it is user-data for cloud-init, not shell commands.
# Sets up: SSH keys only, admin user ops with sudo, firewalld (only SSH open), fail2ban, daily security
# updates (zypper patch, no auto-reboot), Docker (openSUSE packages) + Compose, swap if none, sysctl, journald limit, chrony, admin tools, shell history, weekly cleanup.
# Root keeps key login on port 22, so this cannot lock you out.
# To change settings (ports, admin user, Docker, swap, timezone), edit the /etc/server-init.conf block below first.
# Rerun any time as root: /usr/local/sbin/server-init.sh
# A failed step is logged to /var/log/server-init-failed.log and the next step still runs.
# Generated by tools/render-cloud-init.py from cloud-init/templates. Do not edit by hand.
package_update: true
package_upgrade: true
ssh_pwauth: false

write_files:
  - path: /etc/server-init.conf
    permissions: '0644'
    content: |
      # Read by /usr/local/sbin/server-init.sh. Edit, then rerun the script as root.
      ADMIN_USER=ops
      # Extra open ports, space separated, e.g. "80/tcp 443/tcp". SSH (22/tcp) is always open.
      EXTRA_PORTS=""
      # Set to 0 to skip a component.
      INSTALL_DOCKER=1
      INSTALL_SWAP=1
      TIMEZONE=Europe/Kyiv
      # Weekly cleanup (server-cleanup). INSTALL_CLEANUP=0 turns it off; CLEAN_SCHEDULE is a systemd OnCalendar value.
      INSTALL_CLEANUP=1
      CLEAN_SCHEDULE=weekly
      CLEAN_JOURNAL_TIME=1month
      CLEAN_JOURNAL_SIZE=500M
      CLEAN_AUTOREMOVE=0
      CLEAN_DOCKER_UNUSED_IMAGES=0

  - path: /usr/local/sbin/server-init.sh
    permissions: '0755'
    content: |
@@FILE server/server-init-opensuse.sh@@

runcmd:
  - [bash, /usr/local/sbin/server-init.sh]
